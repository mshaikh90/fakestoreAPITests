{
  "ApiClient": {
    "BaseUrl": "https://fakestoreapi.com/",
    "TimeoutSeconds": 30,
    "EnableHttpLogging": true,
    "CaptureHttpTranscript": true,
    "LogRequestBody": false,
    "LogResponseBody": false,
    "MaxLoggedBodyLength": 4000,
    "EnableRetry": true,
    "MaxRetryAttempts": 2,
    "RetryBaseDelayMilliseconds": 200
  }
}
